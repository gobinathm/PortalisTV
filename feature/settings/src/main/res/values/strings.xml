    <string name="about_title">About</string>
    <string name="about_app_name" translatable="false">Portalis TV</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_provider">A player for your own provider</string>
    <string name="about_provider_text">Portalis TV comes with no channels, portals or content. It plays what the IPTV portal you sign in to provides.</string>

    <string name="about_section_privacy">Privacy</string>
    <string name="about_privacy_nothing">Nothing is collected</string>
    <string name="about_privacy_nothing_text">No analytics, ads, crash reporting or trackers. The developers receive no data from the app.</string>
    <string name="about_privacy_portal">Only your portal</string>
    <string name="about_privacy_portal_text">The app connects only to the portal you entered, and to the streams and images that portal returns. Device identifiers are sent only there.</string>
    <string name="about_privacy_storage">Kept on this TV, encrypted</string>
    <string name="about_privacy_storage_text">Profiles and settings are encrypted and left out of backups. Exports are protected with your password and saved only where you choose.</string>

